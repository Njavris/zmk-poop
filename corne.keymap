#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
			display-name = "Base";
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T       &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSLH
   &kp ESC   &kp A &kp S &kp D &kp F &kp G       &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LALT  &kp Z &kp X &kp C &kp V &kp B       &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RCTRL
                     &kp LSHFT &mo 1 &kp BSPC    &kp SPACE &mo 2 &kp RSHFT
                        >;
                };
                lower_layer {
			display-name = "Lower";
                        bindings = <
   &kp EQUAL &kp N1   &kp N2 &kp N3 &kp N4   &kp N5           &kp N6   &kp N7   &kp N8   &kp N9    &kp N0   &kp MINUS
   &none     &none    &none  &none  &kp HOME &kp PGUP         &kp LEFT &kp DOWN &kp UP   &kp RIGHT &none    &none
   &kp GRAVE &kp LGUI &none  &none  &kp END  &kp PGDN         &none    &kp LBKT &kp RBKT &none     &kp RGUI &kp RCTRL
                             &kp LSHFT &trans &kp DEL         &kp ENTER &trans  &kp RSHFT
                        >;
                };
                raise_layer {
			display-name = "Raise";
                        bindings = <
   &kp PLUS  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR &kp UNDER
   &none     &none    &none  &none   &kp HOME &kp PGUP     &kp LEFT  &kp DOWN &kp UP    &kp RIGHT &none    &none
   &kp TILDE &kp LGUI &none  &none   &kp END  &kp PGDN     &none     &kp LCUR &kp RCUR  &none     &kp RGUI &kp RCTRL
                             &kp LSHFT &trans &kp DEL       &kp ENTER &trans &kp RSHFT
                        >;
                };
		both_layer {
			display-name = "Both";
                        bindings = <
   &kp F1       &kp F2       &kp F3 &kp F4         &kp F5    &kp F6            &kp F7         &kp F8         &kp F9       &kp F10         &kp F11 &kp F12
   &bt BT_SEL 0 &bt BT_SEL 1 &none  &msc SCRL_UP   &none     &none             &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none   &bt BT_CLR
   &bt BT_SEL 2 &none        &none  &msc SCRL_DOWN &mkp  MB1 &mkp MB2          &none          &none          &none        &none           &none   &bt BT_CLR_ALL
                             &kp LSHFT &trans &kp DEL      &kp ENTER &trans &kp RSHFT
                        >;
		};
        };
	conditional_layers {
        	compatible = "zmk,conditional-layers";
        	tri_layer {
            		if-layers = <1 2>;
            		then-layer = <3>;
		};
	};
};
